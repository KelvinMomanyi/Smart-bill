// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  // Custom smart-bill fields
  role String? @default("SCANNER") // 'ADMIN' or 'SCANNER'
}

model Vendor {
  id                      String          @id @default(uuid())
  shop                    String
  name                    String
  address                 String?
  email                   String?
  phone                   String?
  paymentTerms            String?
  defaultCurrency         String?         @default("USD")
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  invoices                Invoice[]
  purchaseOrders          PurchaseOrder[]
  creditNotes             CreditNote[]
  freightLines            FreightLine[]
  uomMappings             UoMMapping[]
  approvalRules           ApprovalRule[]
  defaultLandedCostMethod String?

  @@unique([shop, name])
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  shop           String
  poNumber       String?
  shopifyOrderId String?             @unique // Link to Shopify Order/Transfer ID if applicable
  vendorId       String
  vendor         Vendor              @relation(fields: [vendorId], references: [id])
  status         String              @default("OPEN") // OPEN, PARTIAL, FULFILLED, MISMATCH
  expectedDate   DateTime?
  totalAmount    Float?
  notes          String?
  currency       String              @default("USD")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  items          PurchaseOrderItem[]
  linkedInvoices Invoice[]
  receipts       GoodsReceipt[]

  @@unique([shop, poNumber])
}

model PurchaseOrderItem {
  id               String             @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sku              String?
  shopifyProductId String?
  shopifyVariantId String?
  name             String
  expectedQty      Float
  receivedQty      Float              @default(0)
  billedQty        Float              @default(0)
  expectedRate     Float?
  receiptItems     GoodsReceiptItem[]
}

model Invoice {
  id                 String         @id @default(uuid())
  shop               String
  vendorId           String?
  vendor             Vendor?        @relation(fields: [vendorId], references: [id])
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  invoiceNumber      String?
  imageUrl           String
  storageKey         String?
  sourceFilename     String?
  rawText            String?
  date               DateTime
  dueDate            DateTime?
  currency           String         @default("USD")
  subtotal           Float?
  tax                Float?
  total              Float
  status             String         @default("PENDING_SYNC") // PENDING_SYNC, SYNCED
  reviewStatus       String         @default("PENDING_REVIEW") // PENDING_REVIEW, NEEDS_ATTENTION, APPROVED
  cogsSyncStatus     String         @default("NOT_REQUESTED") // NOT_REQUESTED, SYNCED, FAILED
  accountingStatus   String         @default("NOT_EXPORTED") // NOT_EXPORTED, EXPORTED
  discrepancySummary String?
  documentHash       String?
  identityKey        String?
  landedCostMethod   String         @default("NONE") // NONE, VALUE, QUANTITY, WEIGHT, MANUAL

  landedCostUpdatedAt DateTime?
  fxRate              Float? // Reviewed rate from the invoice currency into the shop currency
  fxRateSource        String? // MANUAL or SHOP_CURRENCY
  fxRateDate          DateTime?
  shopCurrency        String?
  costInShopCurrency  Float?
  approvedAt          DateTime?
  approvedBy          String?
  revision            Int                    @default(0)
  accountingMapping   Json?
  exports             AccountingExport[]
  costChanges         CostChange[]
  creditNotes         CreditNote[]
  creditAllocations   CreditNoteAllocation[] @relation("CreditTargetInvoice")
  freightLines        FreightLine[]
  fxAdjustments       FXAdjustment[]
  approvals           Approval[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  items               InvoiceItem[]

  @@unique([shop, documentHash])
  @@unique([shop, identityKey])
  @@index([shop, createdAt])
}

model InvoiceItem {
  id                  String              @id @default(uuid())
  invoiceId           String
  invoice             Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  shopifyProductId    String? // Mapped Shopify Product ID
  shopifyVariantId    String? // Mapped Shopify Variant ID
  sku                 String?
  name                String
  category            String              @default("PRODUCT") // PRODUCT, FREIGHT, DUTY, HANDLING, INSURANCE, OTHER
  manualCharge        Float? // Manual share of freight and charges for this product line
  supplierUoM         String? // Unit the supplier billed in, when the line states one
  packSize            Float? // Stock units per billed unit, snapshotted for the sync
  convertedQuantity   Float?
  costPerStockUnit    Float?
  landedCostPerUnit   Float?
  quantity            Float               @default(1)
  price               Float // Unit price (Rate)
  amount              Float? // Total amount for this line item
  confidence          Float?
  matchedProductTitle String?
  matchConfirmed      Boolean             @default(false)
  syncCost            Boolean             @default(true)
  freightAllocations  FreightAllocation[]
  creditNoteLines     CreditNoteLine[]
}

model ShopSettings {
  id                     String   @id @default(uuid())
  shop                   String   @unique
  billingPlan            String   @default("STARTER")
  accountingPlatform     String?
  accountingConnected    Boolean  @default(false)
  autoSyncCogs           Boolean  @default(false)
  requireReview          Boolean  @default(true)
  defaultCurrency        String   @default("USD")
  dateOrder              String   @default("DMY")
  xeroAccountCode        String?
  xeroTaxType            String?
  quickBooksAccountId    String?
  quickBooksTaxCodeId    String?
  quickBooksTaxAccountId String?
  inboundAlias           String?  @unique
  minutesSavedPerInvoice Float    @default(0)
  fxRateSourcePreference String   @default("OPENEXCHANGERATES")
  fxRevaluationFrequency String   @default("MANUAL")
  fxGainAccount          String?
  fxLossAccount          String?
  fxRateRounding         Int      @default(6)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model AccountingExport {
  id               String    @id @default(uuid())
  shop             String
  invoiceId        String
  invoice          Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  platform         String
  status           String    @default("PENDING")
  requestKey       String    @unique @default(uuid())
  remoteId         String?
  companyKey       String?
  attachmentStatus String    @default("NOT_REQUESTED")
  attachmentId     String?
  attachmentError  String?
  payload          Json?
  error            String?
  attemptedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([invoiceId, platform])
  @@unique([shop, platform, companyKey, remoteId])
  @@index([shop, status])
}

model CostChange {
  id                String   @id @default(uuid())
  shop              String
  invoiceId         String
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceItemId     String
  inventoryItemId   String
  variantId         String
  previousCost      Float?
  newCost           Float
  landedCostPerUnit Float?
  allocation        Json?
  shopCurrency      String?
  fxRate            Float?
  fxSource          String?
  packSize          Float?
  creditApplied     Float?
  breakdown         Json?
  currency          String
  status            String   @default("PENDING")
  actor             String
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([invoiceId, invoiceItemId])
  @@index([shop, createdAt])
}

model CreditNote {
  id                    String                 @id @default(uuid())
  shop                  String
  vendorId              String?
  vendor                Vendor?                @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  invoiceId             String?
  invoice               Invoice?               @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  creditNoteNumber      String?
  originalInvoiceNumber String?
  amount                Float
  currency              String                 @default("USD")
  reason                String                 @default("OTHER") // RETURN, OVERCHARGE, DISCOUNT, ALLOWANCE, DAMAGE, OTHER
  status                String                 @default("PENDING") // PENDING, MATCHED, APPROVED, APPLIED, VOID
  dateIssued            DateTime?
  dateReceived          DateTime?
  documentHash          String?
  storageKey            String?
  sourceFilename        String?
  rawText               String?
  allocation            Json?
  actor                 String
  approvedAt            DateTime?
  appliedAt             DateTime?
  note                  String?
  accountingPlatform    String?
  accountingReference   String?
  accountingError       String?
  accountedAt           DateTime?
  accountingStatus      String                 @default("NOT_POSTED")
  accountingRequestKey  String?
  lines                 CreditNoteLine[]
  allocations           CreditNoteAllocation[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([shop, documentHash])
  @@index([shop, status])
  @@index([invoiceId])
  @@index([vendorId])
  @@index([shop, originalInvoiceNumber])
}

model CreditNoteLine {
  id             String       @id @default(uuid())
  creditNoteId   String
  creditNote     CreditNote   @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoiceLineId  String?
  invoiceLine    InvoiceItem? @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)
  description    String
  quantity       Float
  unitPrice      Float
  lineAmount     Float
  originalLineId String?

  @@index([creditNoteId])
  @@index([invoiceLineId])
}

model CreditNoteAllocation {
  id               String     @id @default(uuid())
  creditNoteId     String
  creditNote       CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  targetInvoiceId  String
  targetInvoice    Invoice    @relation("CreditTargetInvoice", fields: [targetInvoiceId], references: [id], onDelete: Cascade)
  allocatedAmount  Float
  allocationDate   DateTime   @default(now())
  allocationReason String?

  @@unique([creditNoteId, targetInvoiceId])
  @@index([targetInvoiceId])
}

model FreightLine {
  id            String              @id @default(uuid())
  invoiceId     String
  invoice       Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceItemId String?             @unique
  supplierId    String?
  supplier      Vendor?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  description   String
  amount        Float
  currency      String
  category      String
  allocations   FreightAllocation[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([invoiceId])
  @@index([supplierId])
}

model FreightAllocation {
  id               String      @id @default(uuid())
  freightLineId    String
  freightLine      FreightLine @relation(fields: [freightLineId], references: [id], onDelete: Cascade)
  invoiceLineId    String
  invoiceLine      InvoiceItem @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)
  allocationMethod String
  allocatedAmount  Float
  allocationReason String?
  calculatedBy     String
  allocationDate   DateTime    @default(now())
  adjustedManually Boolean     @default(false)

  @@unique([freightLineId, invoiceLineId])
  @@index([invoiceLineId])
}

model ExchangeRate {
  id               String   @id @default(uuid())
  shop             String
  fromCurrency     String
  toCurrency       String
  rateDate         DateTime
  rate             Float
  source           String
  confidence       Int
  appliedToInvoice Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([shop, fromCurrency, toCurrency, rateDate, source])
  @@index([shop, fromCurrency, toCurrency, rateDate])
}

model FXAdjustment {
  id              String   @id @default(uuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fromCurrency    String
  toCurrency      String
  invoiceAmount   Float
  convertedAmount Float
  rateUsed        Float
  rateDate        DateTime
  rateDifference  Float?
  reason          String
  source          String
  createdAt       DateTime @default(now())

  @@index([invoiceId, createdAt])
}

model UoMMapping {
  id               String   @id @default(uuid())
  shop             String
  supplierId       String
  supplier         Vendor   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  itemKey          String
  supplierUoM      String
  stockUoM         String
  conversionFactor Float
  confidence       String
  lastUsed         DateTime @default(now())
  frequency        Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([shop, supplierId, itemKey, supplierUoM, stockUoM])
  @@index([shop, supplierId])
}

model ApprovalRule {
  id                       String     @id @default(uuid())
  shop                     String
  name                     String
  invoiceAmountMin         Float?
  invoiceAmountMax         Float?
  supplierId               String?
  supplier                 Vendor?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  requiredApprovers        Int        @default(1)
  approverRoles            Json
  escalateIfUnresolvedDays Int        @default(3)
  active                   Boolean    @default(true)
  approvals                Approval[]
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@unique([shop, name])
  @@index([shop, active])
}

model Approval {
  id             String       @id @default(uuid())
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  approvalRuleId String
  approvalRule   ApprovalRule @relation(fields: [approvalRuleId], references: [id], onDelete: Cascade)
  approverId     String?
  assignedTo     String?
  approvedAt     DateTime?
  status         String       @default("PENDING")
  comments       String?
  escalated      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([invoiceId, status])
  @@index([assignedTo, status])
  @@index([invoiceId, approvalRuleId, approverId])
}

model NotificationPreference {
  id                String   @id @default(uuid())
  shop              String
  channel           String
  webhookUrl        String?
  emailAddress      String?
  enabled           Boolean  @default(true)
  notificationTypes Json
  frequency         String   @default("IMMEDIATE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shop, channel])
}

model NotificationLog {
  id             String    @id @default(uuid())
  shop           String
  type           String
  target         String
  status         String
  sentAt         DateTime?
  deliveryStatus String?
  attempts       Int       @default(0)
  error          String?
  createdAt      DateTime  @default(now())

  @@index([shop, createdAt])
}

model ReportingSnapshot {
  id          String   @id @default(uuid())
  shop        String
  periodStart DateTime
  periodEnd   DateTime
  periodType  String
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, periodStart, periodEnd, periodType])
  @@index([shop, periodType, periodStart])
}

model AuditEvent {
  id        String   @id @default(uuid())
  shop      String
  invoiceId String?
  actor     String
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([invoiceId])
}

model SupplierMapping {
  id                 String   @id @default(uuid())
  shop               String
  vendorKey          String
  itemKey            String
  variantId          String
  title              String
  packSize           Float? // Remembered pack size for this supplier item
  supplierUoM        String?
  packUnitOfMeasure  String?
  stockUnitOfMeasure String?
  updatedAt          DateTime @updatedAt

  @@unique([shop, vendorKey, itemKey])
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  shop            String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  reference       String?
  requestKey      String             @unique
  actor           String
  receivedAt      DateTime           @default(now())
  items           GoodsReceiptItem[]

  @@index([shop, receivedAt])
}

model GoodsReceiptItem {
  id                  String            @id @default(uuid())
  receiptId           String
  receipt             GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  quantity            Float
}

model InvoiceJob {
  id              String    @id @default(uuid())
  shop            String
  documentHash    String
  storageKey      String
  filename        String
  contentType     String
  vendorName      String?
  purchaseOrderId String?
  status          String    @default("QUEUED")
  pageCount       Int       @default(0)
  attempts        Int       @default(0)
  invoiceId       String?
  creditNoteId    String?
  error           String?
  availableAt     DateTime  @default(now())
  lockedAt        DateTime?
  leaseToken      String?
  usageMonth      String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([shop, documentHash])
  @@index([status, availableAt])
}

model MonthlyUsage {
  id       String @id @default(uuid())
  shop     String
  month    String
  invoices Int    @default(0)

  @@unique([shop, month])
}

model AccountingConnection {
  id               String    @id @default(uuid())
  shop             String
  platform         String
  accessToken      String
  refreshToken     String?
  tenantId         String?
  realmId          String?
  environment      String    @default("production")
  companyName      String?
  country          String?
  homeCurrency     String?
  xeroConnectionId String?
  scopes           String?
  expiresAt        DateTime?
  connectedAt      DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([shop, platform])
}

model AccountingAuthorization {
  id          String   @id
  shop        String
  platform    String
  environment String   @default("production")
  actor       String
  status      String   @default("CREATED")
  cookieHash  String?
  credentials String?
  companies   Json?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([shop, expiresAt])
}

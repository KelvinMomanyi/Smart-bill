DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/smartbill?sslmode=require
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.example
SCOPES=read_products,write_inventory,read_inventory
# Temporary full Growth-plan bypass for private acceptance testing. Keep false
# for published/production use so Shopify subscription checks are enforced.
SHOPIFY_BILLING_TEST=false
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Server-only sb_secret_ key from Supabase Project Settings > API Keys. Do not
# use the publishable/anon key or expose this value to browser code. Legacy
# projects can use SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=smartbill-documents
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QB_CLIENT_ID=
QB_CLIENT_SECRET=
# production uses QB_CLIENT_ID/SECRET. Sandbox can use a separate credential pair.
QB_ENVIRONMENT=production
QB_SANDBOX_CLIENT_ID=
QB_SANDBOX_CLIENT_SECRET=
# Optional stable base64-encoded 32-byte encryption key. Otherwise a key is
# derived from SHOPIFY_API_SECRET. Configure before connecting providers.
ACCOUNTING_TOKEN_KEY=
CRON_SECRET=
OPENEXCHANGERATES_APP_ID=
SENDGRID_API_KEY=
NOTIFICATION_FROM_EMAIL=
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_DOMAIN=
# Server worker/email OCR only. Dashboard capture and retries use the legacy
# browser Tesseract processor and do not depend on these Google/timeout settings.
OCR_PROVIDER=auto
# For Vercel, store the full Google Cloud Vision service-account JSON in this
# server-only variable. GOOGLE_APPLICATION_CREDENTIALS can instead point to a
# credential JSON file on hosts with a persistent filesystem.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
OCR_TIMEOUT_MS=50000
OCR_MAX_PDF_PAGES=10

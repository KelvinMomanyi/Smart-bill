DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/smartbill?sslmode=require
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.example
SCOPES=read_products,write_inventory,read_inventory
SHOPIFY_BILLING_TEST=false
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Server-only secret from Supabase Project Settings > API Keys. Never expose it
# to browser code. Legacy projects can use SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=smartbill-documents
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QB_CLIENT_ID=
QB_CLIENT_SECRET=
# production uses QB_CLIENT_ID/SECRET. Sandbox can use a separate credential pair.
QB_ENVIRONMENT=production
QB_SANDBOX_CLIENT_ID=
QB_SANDBOX_CLIENT_SECRET=
# Optional stable base64-encoded 32-byte encryption key. Otherwise a key is
# derived from SHOPIFY_API_SECRET. Configure before connecting providers.
ACCOUNTING_TOKEN_KEY=
CRON_SECRET=
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_DOMAIN=
OCR_MAX_PDF_PAGES=10
